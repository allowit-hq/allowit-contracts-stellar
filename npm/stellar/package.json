{
  "name": "@allowit/stellar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "dependencies": {
    "@allowit/core": "github:allowit-hq/allowit-core#v0.5.0",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@stellar/freighter-api": "6.0.1",
    "@stellar/stellar-sdk": "17.3.0"
  },
  "scripts": {
    "build:browser": "tsc -p tsconfig.json",
    "build:owner-verifier": "sh ../../scripts/build-browser-owner-verifier.sh",
    "test:browser": "node --test --experimental-test-module-mocks tests/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9.2"
  },
  "packageManager": "pnpm@12.11.2"
}
